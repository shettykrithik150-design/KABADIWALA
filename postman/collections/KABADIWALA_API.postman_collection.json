    {
      "name": "Scrap",
      "item": [
        {
          "name": "Add Scrap with Photo (multipart/form-data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.scrapId) {",
                  "    pm.collectionVariables.set('scrapId', jsonData.scrapId);",
                  "}",
                  "if (jsonData.imageUrl) {",
                  "    var parts = jsonData.imageUrl.split('/');",
                  "    pm.collectionVariables.set('uploadedFilename', parts[parts.length - 1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{collectorToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Copper Wiring",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Metal",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "High grade stripped electrical copper wires",
                  "type": "text"
                },
                {
                  "key": "price_per_kg",
                  "value": "450.00",
                  "type": "text"
                },
                {
                  "key": "quantity_kg",
                  "value": "50.00",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "42 MG Road, Bengaluru",
                  "type": "text"
                },
                {
                  "key": "pincode",
                  "value": "560001",
                  "type": "text"
                },
                {
                  "key": "latitude",
                  "value": "12.9716",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "77.5946",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/scrap",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scrap"
              ]
            },
            "description": "Add a scrap listing with multipart photo upload, pricing and GPS coordinates. Collector only."
          }
        },
